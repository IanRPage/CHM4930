# ai/ data and model artifacts - keep the folders, ignore their contents
ai/data/*
!ai/data/.gitkeep
!ai/data/baseline/
ai/data/baseline/*
!ai/data/baseline/combined.csv
!ai/data/baseline/results.csv
ai/checkpoints/*
!ai/checkpoints/.gitkeep
ai/outputs/*
!ai/outputs/.gitkeep

# model or weight files anywhere under ai dir
ai/**/*.pt
ai/**/*.pth
ai/**/*.ckpt
ai/**/*.h5
ai/**/*.onnx
ai/**/*.safetensors
ai/**/*.npy
ai/**/*.npz

# python
__pycache__/
.coverage
coverage.xml
*.pyc
*.pyo
.ipynb_checkpoints/

# conda / env
.conda/
*.egg-info/

# OS / editor
.DS_Store
.vscode
.zed
.idea
