{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix frontend && npm ci --prefix backend",
  "buildCommand": "npm run build --prefix frontend && npm run build --prefix backend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 40,
      "includeFiles": "backend/node_modules/{@rdkit/rdkit/dist/RDKit_minimal.wasm,openchemlib/dist/resources.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
